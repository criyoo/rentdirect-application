{
  "name": "rentdirect",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "rentdirect",
      "workspaces": [
        "apps/web",
        "apps/worker",
        "packages/*"
      ]
    },
    "node_modules/@rentdirect/config": {
      "resolved": "packages/config",
      "link": true
    },
    "node_modules/@rentdirect/types": {
      "resolved": "packages/types",
      "link": true
    },
    "node_modules/@rentdirect/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "node_modules/@rentdirect/utils": {
      "resolved": "packages/utils",
      "link": true
    },
    "packages/config": {
      "name": "@rentdirect/config",
      "version": "0.0.0"
    },
    "packages/types": {
      "name": "@rentdirect/types",
      "version": "0.0.0"
    },
    "packages/ui": {
      "name": "@rentdirect/ui",
      "version": "0.0.0"
    },
    "packages/utils": {
      "name": "@rentdirect/utils",
      "version": "0.0.0"
    }
  }
}
