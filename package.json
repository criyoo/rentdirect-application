{
  "name": "rentdirect",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/worker",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose up --build",
    "dev:web": "npm -w apps/web run dev",
    "build:web": "npm -w apps/web run build",
    "lint:web": "npm -w apps/web run lint",
    "web:dev": "npm -w apps/web run dev",
    "web:build": "npm -w apps/web run build",
    "web:lint": "npm -w apps/web run lint"
  }
}
