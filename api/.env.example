# Django Backend
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_TIME_ZONE=Africa/Lagos
DJANGO_ENV=local

# Postgres
POSTGRES_DB=rentdirectdb
POSTGRES_USER=rentdirect
POSTGRES_PASSWORD=rentdirect
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Valkey
VALKEY_URL=redis://valkey:6379/0
REDIS_URL=redis://valkey:6379/0

# Payment queue
# Docker Compose uses RQ over Valkey. AWS ECS uses SQS through Terraform-provided env vars.
PAYMENT_QUEUE_BACKEND=rq
PAYMENT_QUEUE_NAME=rentdirect-payments
PAYMENT_QUEUE_REDIS_URL=redis://valkey:6379/0
PAYMENT_QUEUE_READY_PAYOUT_INTERVAL_SECONDS=900
PAYMENT_QUEUE_SUBSCRIPTION_RENEWAL_INTERVAL_SECONDS=3600
PAYMENT_QUEUE_JOB_TIMEOUT_SECONDS=300


API_PUBLIC_URL=http://localhost:8600
WEB_PUBLIC_URL=http://localhost:3600

# Frontend
WEB_URL=http://localhost:3600
COMPANY_VERIFICATION_ADMIN_EMAIL=admin@rentdirect.homes

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
AUTH_REFRESH_COOKIE_DEFAULT_MAX_AGE=1209600
AUTH_REFRESH_COOKIE_REMEMBER_MAX_AGE=2592000
FIELD_ENCRYPTION_KEY=FF9nHsWXW9oOUu9U2Qgup4wyDv9pdo8HGc_Vn3q9AmY=


# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=http://localhost:3600
CSRF_TRUSTED_ORIGINS=http://localhost:3600,http://127.0.0.1:3600,https://dev.rentdirect.homes,https://rentdirect.homes

# Auth cookies
AUTH_REFRESH_COOKIE_NAME=rentdirect_refresh
AUTH_REFRESH_COOKIE_PATH=/
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_SECURE=False
AUTH_REFRESH_COOKIE_DOMAIN=

# S3-compatible media storage (MinIO locally)
AWS_STORAGE_BUCKET_NAME=rentdirect-local-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_CUSTOM_DOMAIN=localhost:9600/rentdirect-local-media
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_URL_PROTOCOL=http:
HOMEPAGE_VIDEO_STORAGE_NAME=seed/video/rentdirect.mp4
HOMEPAGE_VIDEO_SOURCE_PATH=uploads/seed/video/rentdirect.mp4


# Flutterwave local Docker Compose setup
# Local billing uses the Flutterwave v3 sandbox configuration.
FLUTTERWAVE_API_VERSION=v3
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_API_BASE_URL=https://developersandbox-api.flutterwave.com
FLUTTERWAVE_V3_API_BASE_URL=https://developersandbox-api.flutterwave.com/v3
FLUTTERWAVE_TOKEN_URL=https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token
FLUTTERWAVE_VIRTUAL_ACCOUNT_EXPIRY_SECONDS=86400
FLUTTERWAVE_PAYOUT_BALANCE_DELAY_HOURS=
ENFORCE_FLUTTERWAVE_WEBHOOK_SIGNATURE=True
FLUTTERWAVE_PAYOUT_RELEASE_WATCH_INTERVAL_SECONDS=900
SUBSCRIPTION_RENEWAL_WATCH_INTERVAL_SECONDS=3600
