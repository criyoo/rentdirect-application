RENTDIRECT_SUBSCRIPTION_BUSINESS_MOBILE=08000000000
RENTDIRECT_SUBSCRIPTION_SUBACCOUNT_COUNTRY=NG
RENTDIRECT_SUBSCRIPTION_SUBACCOUNT_SPLIT_TYPE=flat
RENTDIRECT_SUBSCRIPTION_SUBACCOUNT_SPLIT_VALUE=0
