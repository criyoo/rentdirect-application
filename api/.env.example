FLUTTERWAVE_PAYOUT_BALANCE_DELAY_HOURS=24
SUBSCRIPTION_RENEWAL_WATCH_INTERVAL_SECONDS=3600
RENTDIRECT_OPERATING_BANK_NAME=Opay
RENTDIRECT_OPERATING_BANK_CODE=
