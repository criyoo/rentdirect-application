# Email
# Local development defaults to console email output unless LOCAL_USE_SMTP_EMAIL=True.
# Set LOCAL_USE_SMTP_EMAIL=True only when you want to send real SMTP mail locally.
LOCAL_USE_SMTP_EMAIL=False
LOCAL_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
OTP_EMAIL_FALLBACK_ENABLED=True
OTP_EMAIL_FALLBACK_BACKEND=django.core.mail.backends.console.EmailBackend
OTP_EXPIRY_SECONDS=600
OTP_RESEND_WINDOW_SECONDS=60
OTP_MAX_ATTEMPTS=5
DEFAULT_FROM_EMAIL=noreply@rentdirect.homes
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_FROM_EMAIL=info@rentdirect.homes
SERVER_EMAIL=info@rentdirect.homes
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_HOST_USER=info@rentdirect.homes
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=60
OTP_EMAIL_ASYNC=False
