# AI chat assistant (optional). Uses any OpenAI-compatible /chat/completions endpoint.
# Leave empty to use the built-in keyword-search assistant fallback.
# OpenRouter (NVIDIA Nemotron free tier): set OPENROUTER_API_KEY only — base URL and model default automatically.
OPENROUTER_API_KEY=
# Ollama (free, self-hosted): AI_CHAT_BASE_URL=http://localhost:11434/v1 AI_CHAT_MODEL=llama3.2
# Gemini free tier: AI_CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai AI_CHAT_MODEL=gemini-2.5-flash
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
# Comma-separated backup models tried in order when the primary model errors.
# AI_CHAT_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-120b:free
AI_CHAT_TIMEOUT_SECONDS=45
AI_CHAT_MAX_TOOL_ROUNDS=4
AI_CHAT_SEARCH_LIMIT=12
